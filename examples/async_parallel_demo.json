{
  "name": "Async Parallel Demo",
  "version": "1.0.0",
  "description": "演示并行异步执行：启动两个异步任务并行计算，最后合并结果",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "label": "开始",
      "input_pins": [],
      "output_pins": [
        {
          "name": "value_a",
          "type": "float",
          "value": 10
        },
        {
          "name": "value_b",
          "type": "float",
          "value": 20
        }
      ],
      "position": {"x": 100, "y": 300}
    },
    {
      "id": "async_start_1",
      "type": "function",
      "operation": "async_start",
      "label": "异步任务1",
      "input_pins": [],
      "output_pins": [
        {"name": "task_id", "type": "string"},
        {"name": "started", "type": "bool"}
      ],
      "position": {"x": 300, "y": 200}
    },
    {
      "id": "async_start_2",
      "type": "function",
      "operation": "async_start",
      "label": "异步任务2",
      "input_pins": [],
      "output_pins": [
        {"name": "task_id", "type": "string"},
        {"name": "started", "type": "bool"}
      ],
      "position": {"x": 300, "y": 400}
    },
    {
      "id": "sleep_1",
      "type": "function",
      "operation": "sleep",
      "label": "休眠1秒",
      "input_pins": [
        {"name": "duration", "type": "float", "value": 1000}
      ],
      "output_pins": [
        {"name": "done", "type": "bool"}
      ],
      "position": {"x": 500, "y": 200}
    },
    {
      "id": "sleep_2",
      "type": "function",
      "operation": "sleep",
      "label": "休眠1.5秒",
      "input_pins": [
        {"name": "duration", "type": "float", "value": 1500}
      ],
      "output_pins": [
        {"name": "done", "type": "bool"}
      ],
      "position": {"x": 500, "y": 400}
    },
    {
      "id": "calc_1",
      "type": "arithmetic",
      "operation": "multiply",
      "label": "任务1: x2",
      "input_pins": [
        {"name": "a", "type": "float"},
        {"name": "b", "type": "float", "value": 2}
      ],
      "output_pins": [
        {"name": "result", "type": "float"}
      ],
      "position": {"x": 700, "y": 200}
    },
    {
      "id": "calc_2",
      "type": "arithmetic",
      "operation": "multiply",
      "label": "任务2: x3",
      "input_pins": [
        {"name": "a", "type": "float"},
        {"name": "b", "type": "float", "value": 3}
      ],
      "output_pins": [
        {"name": "result", "type": "float"}
      ],
      "position": {"x": 700, "y": 400}
    },
    {
      "id": "async_end_1",
      "type": "function",
      "operation": "async_end",
      "label": "异步结束1",
      "input_pins": [
        {"name": "task_id", "type": "string"},
        {"name": "result", "type": "any"}
      ],
      "output_pins": [
        {"name": "completed", "type": "bool"}
      ],
      "position": {"x": 900, "y": 200}
    },
    {
      "id": "async_end_2",
      "type": "function",
      "operation": "async_end",
      "label": "异步结束2",
      "input_pins": [
        {"name": "task_id", "type": "string"},
        {"name": "result", "type": "any"}
      ],
      "output_pins": [
        {"name": "completed", "type": "bool"}
      ],
      "position": {"x": 900, "y": 400}
    },
    {
      "id": "parallel",
      "type": "function",
      "operation": "parallel",
      "label": "并行等待",
      "input_pins": [
        {"name": "task_1", "type": "string"},
        {"name": "task_2", "type": "string"}
      ],
      "output_pins": [
        {"name": "result_0", "type": "any"},
        {"name": "result_1", "type": "any"},
        {"name": "count", "type": "float"},
        {"name": "all_completed", "type": "bool"}
      ],
      "position": {"x": 1100, "y": 300}
    },
    {
      "id": "add_results",
      "type": "arithmetic",
      "operation": "add",
      "label": "合并结果",
      "input_pins": [
        {"name": "a", "type": "float"},
        {"name": "b", "type": "float"}
      ],
      "output_pins": [
        {"name": "result", "type": "float"}
      ],
      "position": {"x": 1300, "y": 300}
    },
    {
      "id": "end",
      "type": "end",
      "label": "结束",
      "input_pins": [
        {"name": "total", "type": "float"},
        {"name": "task_count", "type": "float"}
      ],
      "output_pins": [],
      "position": {"x": 1500, "y": 300}
    }
  ],
  "connections": [
    {"id": "c1", "source_node": "start", "source_pin": "value_a", "target_node": "calc_1", "target_pin": "a"},
    {"id": "c2", "source_node": "start", "source_pin": "value_b", "target_node": "calc_2", "target_pin": "a"},
    {"id": "c3", "source_node": "async_start_1", "source_pin": "task_id", "target_node": "async_end_1", "target_pin": "task_id"},
    {"id": "c4", "source_node": "async_start_2", "source_pin": "task_id", "target_node": "async_end_2", "target_pin": "task_id"},
    {"id": "c5", "source_node": "async_start_1", "source_pin": "task_id", "target_node": "parallel", "target_pin": "task_1"},
    {"id": "c6", "source_node": "async_start_2", "source_pin": "task_id", "target_node": "parallel", "target_pin": "task_2"},
    {"id": "c7", "source_node": "calc_1", "source_pin": "result", "target_node": "async_end_1", "target_pin": "result"},
    {"id": "c8", "source_node": "calc_2", "source_pin": "result", "target_node": "async_end_2", "target_pin": "result"},
    {"id": "c9", "source_node": "parallel", "source_pin": "result_0", "target_node": "add_results", "target_pin": "a"},
    {"id": "c10", "source_node": "parallel", "source_pin": "result_1", "target_node": "add_results", "target_pin": "b"},
    {"id": "c11", "source_node": "add_results", "source_pin": "result", "target_node": "end", "target_pin": "total"},
    {"id": "c12", "source_node": "parallel", "source_pin": "count", "target_node": "end", "target_pin": "task_count"}
  ],
  "variables": {},
  "metadata": {
    "description": "并行执行两个异步任务：任务1计算10*2=20（1秒），任务2计算20*3=60（1.5秒），最后合并得80"
  }
}
