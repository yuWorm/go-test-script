{
  "name": "Temperature Converter and Analyzer",
  "version": "1.0.0",
  "description": "温度转换器：摄氏度转换为华氏度和开尔文，并根据温度范围进行多级分类",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "label": "开始",
      "input_pins": [],
      "output_pins": [
        {"name": "exec", "kind": "exec", "type": "exec"},
        {"name": "celsius", "kind": "data", "type": "float", "value": 25}
      ],
      "position": {"x": 50, "y": 400}
    },
    {
      "id": "celsius_to_fahrenheit_calc",
      "type": "arithmetic",
      "operation": "multiply",
      "label": "C * 1.8",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "float"},
        {"name": "b", "kind": "data", "type": "float", "value": 1.8}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "float"}
      ],
      "position": {"x": 250, "y": 300}
    },
    {
      "id": "fahrenheit_add_32",
      "type": "arithmetic",
      "operation": "add",
      "label": "F = C*1.8 + 32",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "float"},
        {"name": "b", "kind": "data", "type": "float", "value": 32}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "float"}
      ],
      "position": {"x": 450, "y": 300}
    },
    {
      "id": "celsius_to_kelvin",
      "type": "arithmetic",
      "operation": "add",
      "label": "K = C + 273.15",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "float"},
        {"name": "b", "kind": "data", "type": "float", "value": 273.15}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "float"}
      ],
      "position": {"x": 450, "y": 500}
    },
    {
      "id": "check_freezing",
      "type": "arithmetic",
      "operation": "less_equal",
      "label": "C <= 0 (冰点)?",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "float"},
        {"name": "b", "kind": "data", "type": "float", "value": 0}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "bool"}
      ],
      "position": {"x": 650, "y": 400}
    },
    {
      "id": "branch_freezing",
      "type": "function",
      "operation": "branch",
      "label": "分支：冰冻",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "condition", "kind": "data", "type": "bool"}
      ],
      "output_pins": [
        {"name": "true_exec", "kind": "exec", "type": "exec"},
        {"name": "false_exec", "kind": "exec", "type": "exec"}
      ],
      "position": {"x": 850, "y": 400}
    },
    {
      "id": "category_freezing",
      "type": "function",
      "operation": "constant",
      "label": "类别：冰冻",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "value", "kind": "data", "type": "float", "value": 1}
      ],
      "position": {"x": 1050, "y": 300}
    },
    {
      "id": "check_boiling",
      "type": "arithmetic",
      "operation": "greater_equal",
      "label": "C >= 100 (沸点)?",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "float"},
        {"name": "b", "kind": "data", "type": "float", "value": 100}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "bool"}
      ],
      "position": {"x": 1050, "y": 450}
    },
    {
      "id": "branch_boiling",
      "type": "function",
      "operation": "branch",
      "label": "分支：沸腾",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "condition", "kind": "data", "type": "bool"}
      ],
      "output_pins": [
        {"name": "true_exec", "kind": "exec", "type": "exec"},
        {"name": "false_exec", "kind": "exec", "type": "exec"}
      ],
      "position": {"x": 1250, "y": 450}
    },
    {
      "id": "category_boiling",
      "type": "function",
      "operation": "constant",
      "label": "类别：沸腾",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "value", "kind": "data", "type": "float", "value": 3}
      ],
      "position": {"x": 1450, "y": 400}
    },
    {
      "id": "check_comfortable",
      "type": "arithmetic",
      "operation": "greater",
      "label": "C > 15 (舒适)?",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "float"},
        {"name": "b", "kind": "data", "type": "float", "value": 15}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "bool"}
      ],
      "position": {"x": 1450, "y": 500}
    },
    {
      "id": "branch_comfortable",
      "type": "function",
      "operation": "branch",
      "label": "分支：舒适",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "condition", "kind": "data", "type": "bool"}
      ],
      "output_pins": [
        {"name": "true_exec", "kind": "exec", "type": "exec"},
        {"name": "false_exec", "kind": "exec", "type": "exec"}
      ],
      "position": {"x": 1650, "y": 500}
    },
    {
      "id": "category_comfortable",
      "type": "function",
      "operation": "constant",
      "label": "类别：舒适",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "value", "kind": "data", "type": "float", "value": 2.5}
      ],
      "position": {"x": 1850, "y": 450}
    },
    {
      "id": "category_cold",
      "type": "function",
      "operation": "constant",
      "label": "类别：寒冷",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "value", "kind": "data", "type": "float", "value": 2}
      ],
      "position": {"x": 1850, "y": 550}
    },
    {
      "id": "end",
      "type": "end",
      "label": "结束",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "fahrenheit", "kind": "data", "type": "float"},
        {"name": "kelvin", "kind": "data", "type": "float"},
        {"name": "category", "kind": "data", "type": "float"}
      ],
      "output_pins": [],
      "position": {"x": 2050, "y": 400}
    }
  ],
  "connections": [
    {"id": "e1", "source_node": "start", "source_pin": "exec", "target_node": "celsius_to_fahrenheit_calc", "target_pin": "exec_in"},
    {"id": "d1", "source_node": "start", "source_pin": "celsius", "target_node": "celsius_to_fahrenheit_calc", "target_pin": "a"},

    {"id": "e2", "source_node": "celsius_to_fahrenheit_calc", "source_pin": "exec_out", "target_node": "fahrenheit_add_32", "target_pin": "exec_in"},
    {"id": "d2", "source_node": "celsius_to_fahrenheit_calc", "source_pin": "result", "target_node": "fahrenheit_add_32", "target_pin": "a"},

    {"id": "e3", "source_node": "fahrenheit_add_32", "source_pin": "exec_out", "target_node": "celsius_to_kelvin", "target_pin": "exec_in"},
    {"id": "d3", "source_node": "start", "source_pin": "celsius", "target_node": "celsius_to_kelvin", "target_pin": "a"},

    {"id": "e4", "source_node": "celsius_to_kelvin", "source_pin": "exec_out", "target_node": "check_freezing", "target_pin": "exec_in"},
    {"id": "d4", "source_node": "start", "source_pin": "celsius", "target_node": "check_freezing", "target_pin": "a"},

    {"id": "e5", "source_node": "check_freezing", "source_pin": "exec_out", "target_node": "branch_freezing", "target_pin": "exec_in"},
    {"id": "d5", "source_node": "check_freezing", "source_pin": "result", "target_node": "branch_freezing", "target_pin": "condition"},

    {"id": "e6_true", "source_node": "branch_freezing", "source_pin": "true_exec", "target_node": "category_freezing", "target_pin": "exec_in"},

    {"id": "e6_false", "source_node": "branch_freezing", "source_pin": "false_exec", "target_node": "check_boiling", "target_pin": "exec_in"},
    {"id": "d6", "source_node": "start", "source_pin": "celsius", "target_node": "check_boiling", "target_pin": "a"},

    {"id": "e7", "source_node": "check_boiling", "source_pin": "exec_out", "target_node": "branch_boiling", "target_pin": "exec_in"},
    {"id": "d7", "source_node": "check_boiling", "source_pin": "result", "target_node": "branch_boiling", "target_pin": "condition"},

    {"id": "e8_true", "source_node": "branch_boiling", "source_pin": "true_exec", "target_node": "category_boiling", "target_pin": "exec_in"},

    {"id": "e8_false", "source_node": "branch_boiling", "source_pin": "false_exec", "target_node": "check_comfortable", "target_pin": "exec_in"},
    {"id": "d8", "source_node": "start", "source_pin": "celsius", "target_node": "check_comfortable", "target_pin": "a"},

    {"id": "e9", "source_node": "check_comfortable", "source_pin": "exec_out", "target_node": "branch_comfortable", "target_pin": "exec_in"},
    {"id": "d9", "source_node": "check_comfortable", "source_pin": "result", "target_node": "branch_comfortable", "target_pin": "condition"},

    {"id": "e10_true", "source_node": "branch_comfortable", "source_pin": "true_exec", "target_node": "category_comfortable", "target_pin": "exec_in"},
    {"id": "e10_false", "source_node": "branch_comfortable", "source_pin": "false_exec", "target_node": "category_cold", "target_pin": "exec_in"},

    {"id": "e11_freezing", "source_node": "category_freezing", "source_pin": "exec_out", "target_node": "end", "target_pin": "exec_in"},
    {"id": "d10", "source_node": "category_freezing", "source_pin": "value", "target_node": "end", "target_pin": "category"},

    {"id": "e11_boiling", "source_node": "category_boiling", "source_pin": "exec_out", "target_node": "end", "target_pin": "exec_in"},
    {"id": "d11", "source_node": "category_boiling", "source_pin": "value", "target_node": "end", "target_pin": "category"},

    {"id": "e11_comfortable", "source_node": "category_comfortable", "source_pin": "exec_out", "target_node": "end", "target_pin": "exec_in"},
    {"id": "d12", "source_node": "category_comfortable", "source_pin": "value", "target_node": "end", "target_pin": "category"},

    {"id": "e11_cold", "source_node": "category_cold", "source_pin": "exec_out", "target_node": "end", "target_pin": "exec_in"},
    {"id": "d13", "source_node": "category_cold", "source_pin": "value", "target_node": "end", "target_pin": "category"},

    {"id": "d14", "source_node": "fahrenheit_add_32", "source_pin": "result", "target_node": "end", "target_pin": "fahrenheit"},
    {"id": "d15", "source_node": "celsius_to_kelvin", "source_pin": "result", "target_node": "end", "target_pin": "kelvin"}
  ],
  "variables": {},
  "metadata": {
    "description": "温度分析器：将摄氏度转换为华氏度和开尔文，并通过多级分支判断温度类别",
    "categories": {
      "1": "冰冻 (<=0°C)",
      "2": "寒冷 (0-15°C)",
      "2.5": "舒适 (15-100°C)",
      "3": "沸腾 (>=100°C)"
    },
    "expected_result_25C": "华氏度: 77, 开尔文: 298.15, 类别: 2.5 (舒适)"
  }
}
