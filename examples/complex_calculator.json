{
  "name": "Complex Calculator with Validation",
  "version": "1.0.0",
  "description": "复杂计算器：执行多步计算、验证输入、处理边界情况",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "label": "开始",
      "input_pins": [],
      "output_pins": [
        {"name": "exec", "kind": "exec", "type": "exec"},
        {"name": "input_a", "kind": "data", "type": "float", "value": 100},
        {"name": "input_b", "kind": "data", "type": "float", "value": 25}
      ],
      "position": {"x": 50, "y": 300}
    },
    {
      "id": "validate_b",
      "type": "arithmetic",
      "operation": "not_equal",
      "label": "验证B不为0",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "float"},
        {"name": "b", "kind": "data", "type": "float", "value": 0}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "bool"}
      ],
      "position": {"x": 250, "y": 300}
    },
    {
      "id": "branch_validate",
      "type": "function",
      "operation": "branch",
      "label": "检查验证结果",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "condition", "kind": "data", "type": "bool"}
      ],
      "output_pins": [
        {"name": "true_exec", "kind": "exec", "type": "exec"},
        {"name": "false_exec", "kind": "exec", "type": "exec"}
      ],
      "position": {"x": 450, "y": 300}
    },
    {
      "id": "add_values",
      "type": "arithmetic",
      "operation": "add",
      "label": "A + B",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "float"},
        {"name": "b", "kind": "data", "type": "float"}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "float"}
      ],
      "position": {"x": 650, "y": 200}
    },
    {
      "id": "multiply_values",
      "type": "arithmetic",
      "operation": "multiply",
      "label": "A * B",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "float"},
        {"name": "b", "kind": "data", "type": "float"}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "float"}
      ],
      "position": {"x": 850, "y": 200}
    },
    {
      "id": "divide_values",
      "type": "arithmetic",
      "operation": "divide",
      "label": "Sum / Product",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "float"},
        {"name": "b", "kind": "data", "type": "float"}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "float"}
      ],
      "position": {"x": 1050, "y": 200}
    },
    {
      "id": "check_result_range",
      "type": "arithmetic",
      "operation": "less",
      "label": "结果 < 1?",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "float"},
        {"name": "b", "kind": "data", "type": "float", "value": 1}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "bool"}
      ],
      "position": {"x": 1250, "y": 200}
    },
    {
      "id": "branch_range",
      "type": "function",
      "operation": "branch",
      "label": "分支：小数/整数",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "condition", "kind": "data", "type": "bool"}
      ],
      "output_pins": [
        {"name": "true_exec", "kind": "exec", "type": "exec"},
        {"name": "false_exec", "kind": "exec", "type": "exec"}
      ],
      "position": {"x": 1450, "y": 200}
    },
    {
      "id": "multiply_small",
      "type": "arithmetic",
      "operation": "multiply",
      "label": "小数放大100倍",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "float"},
        {"name": "b", "kind": "data", "type": "float", "value": 100}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "float"}
      ],
      "position": {"x": 1650, "y": 150}
    },
    {
      "id": "power_large",
      "type": "arithmetic",
      "operation": "power",
      "label": "整数平方",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "float"},
        {"name": "b", "kind": "data", "type": "float", "value": 2}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "float"}
      ],
      "position": {"x": 1650, "y": 250}
    },
    {
      "id": "error_result",
      "type": "function",
      "operation": "constant",
      "label": "错误：除数为0",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "value", "kind": "data", "type": "float", "value": -1}
      ],
      "position": {"x": 650, "y": 400}
    },
    {
      "id": "end_success",
      "type": "end",
      "label": "成功结束",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "final_result", "kind": "data", "type": "float"}
      ],
      "output_pins": [],
      "position": {"x": 1850, "y": 200}
    },
    {
      "id": "end_error",
      "type": "end",
      "label": "错误结束",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "error_code", "kind": "data", "type": "float"}
      ],
      "output_pins": [],
      "position": {"x": 850, "y": 400}
    }
  ],
  "connections": [
    {"id": "e1", "source_node": "start", "source_pin": "exec", "target_node": "validate_b", "target_pin": "exec_in"},
    {"id": "d1", "source_node": "start", "source_pin": "input_b", "target_node": "validate_b", "target_pin": "a"},

    {"id": "e2", "source_node": "validate_b", "source_pin": "exec_out", "target_node": "branch_validate", "target_pin": "exec_in"},
    {"id": "d2", "source_node": "validate_b", "source_pin": "result", "target_node": "branch_validate", "target_pin": "condition"},

    {"id": "e3_true", "source_node": "branch_validate", "source_pin": "true_exec", "target_node": "add_values", "target_pin": "exec_in"},
    {"id": "d3", "source_node": "start", "source_pin": "input_a", "target_node": "add_values", "target_pin": "a"},
    {"id": "d4", "source_node": "start", "source_pin": "input_b", "target_node": "add_values", "target_pin": "b"},

    {"id": "e4", "source_node": "add_values", "source_pin": "exec_out", "target_node": "multiply_values", "target_pin": "exec_in"},
    {"id": "d5", "source_node": "start", "source_pin": "input_a", "target_node": "multiply_values", "target_pin": "a"},
    {"id": "d6", "source_node": "start", "source_pin": "input_b", "target_node": "multiply_values", "target_pin": "b"},

    {"id": "e5", "source_node": "multiply_values", "source_pin": "exec_out", "target_node": "divide_values", "target_pin": "exec_in"},
    {"id": "d7", "source_node": "add_values", "source_pin": "result", "target_node": "divide_values", "target_pin": "a"},
    {"id": "d8", "source_node": "multiply_values", "source_pin": "result", "target_node": "divide_values", "target_pin": "b"},

    {"id": "e6", "source_node": "divide_values", "source_pin": "exec_out", "target_node": "check_result_range", "target_pin": "exec_in"},
    {"id": "d9", "source_node": "divide_values", "source_pin": "result", "target_node": "check_result_range", "target_pin": "a"},

    {"id": "e7", "source_node": "check_result_range", "source_pin": "exec_out", "target_node": "branch_range", "target_pin": "exec_in"},
    {"id": "d10", "source_node": "check_result_range", "source_pin": "result", "target_node": "branch_range", "target_pin": "condition"},

    {"id": "e8_true", "source_node": "branch_range", "source_pin": "true_exec", "target_node": "multiply_small", "target_pin": "exec_in"},
    {"id": "d11", "source_node": "divide_values", "source_pin": "result", "target_node": "multiply_small", "target_pin": "a"},

    {"id": "e8_false", "source_node": "branch_range", "source_pin": "false_exec", "target_node": "power_large", "target_pin": "exec_in"},
    {"id": "d12", "source_node": "divide_values", "source_pin": "result", "target_node": "power_large", "target_pin": "a"},

    {"id": "e9_small", "source_node": "multiply_small", "source_pin": "exec_out", "target_node": "end_success", "target_pin": "exec_in"},
    {"id": "d13", "source_node": "multiply_small", "source_pin": "result", "target_node": "end_success", "target_pin": "final_result"},

    {"id": "e9_large", "source_node": "power_large", "source_pin": "exec_out", "target_node": "end_success", "target_pin": "exec_in"},
    {"id": "d14", "source_node": "power_large", "source_pin": "result", "target_node": "end_success", "target_pin": "final_result"},

    {"id": "e3_false", "source_node": "branch_validate", "source_pin": "false_exec", "target_node": "error_result", "target_pin": "exec_in"},
    {"id": "e10", "source_node": "error_result", "source_pin": "exec_out", "target_node": "end_error", "target_pin": "exec_in"},
    {"id": "d15", "source_node": "error_result", "source_pin": "value", "target_node": "end_error", "target_pin": "error_code"}
  ],
  "variables": {},
  "metadata": {
    "description": "复杂计算示例：验证输入 -> 加法和乘法 -> 除法 -> 根据结果大小分支处理（小数放大/整数平方）",
    "expected_result": "输入100和25: (100+25)/(100*25)=125/2500=0.05 -> 小于1 -> 放大100倍 -> 5.0"
  }
}
