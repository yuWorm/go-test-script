{
  "name": "Execution Pins Demo",
  "version": "1.0.0",
  "description": "演示执行引脚：Start -> Add -> Branch -> Multiply/Subtract -> End",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "label": "开始",
      "input_pins": [],
      "output_pins": [
        {"name": "exec", "kind": "exec", "type": "exec"},
        {"name": "value_a", "kind": "data", "type": "float", "value": 10},
        {"name": "value_b", "kind": "data", "type": "float", "value": 5}
      ],
      "position": {"x": 100, "y": 250}
    },
    {
      "id": "add",
      "type": "arithmetic",
      "operation": "add",
      "label": "加法",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "float"},
        {"name": "b", "kind": "data", "type": "float"}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "float"}
      ],
      "position": {"x": 300, "y": 250}
    },
    {
      "id": "branch",
      "type": "function",
      "operation": "branch",
      "label": "分支",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "condition", "kind": "data", "type": "bool", "value": true}
      ],
      "output_pins": [
        {"name": "true_exec", "kind": "exec", "type": "exec"},
        {"name": "false_exec", "kind": "exec", "type": "exec"}
      ],
      "position": {"x": 500, "y": 250}
    },
    {
      "id": "multiply",
      "type": "arithmetic",
      "operation": "multiply",
      "label": "乘以2 (True分支)",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "float"},
        {"name": "b", "kind": "data", "type": "float", "value": 2}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "float"}
      ],
      "position": {"x": 700, "y": 200}
    },
    {
      "id": "subtract",
      "type": "arithmetic",
      "operation": "subtract",
      "label": "减5 (False分支)",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "float"},
        {"name": "b", "kind": "data", "type": "float", "value": 5}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "float"}
      ],
      "position": {"x": 700, "y": 300}
    },
    {
      "id": "end",
      "type": "end",
      "label": "结束",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "final_result", "kind": "data", "type": "float"}
      ],
      "output_pins": [],
      "position": {"x": 900, "y": 250}
    }
  ],
  "connections": [
    {"id": "exec1", "source_node": "start", "source_pin": "exec", "target_node": "add", "target_pin": "exec_in"},
    {"id": "data1", "source_node": "start", "source_pin": "value_a", "target_node": "add", "target_pin": "a"},
    {"id": "data2", "source_node": "start", "source_pin": "value_b", "target_node": "add", "target_pin": "b"},
    {"id": "exec2", "source_node": "add", "source_pin": "exec_out", "target_node": "branch", "target_pin": "exec_in"},
    {"id": "data3", "source_node": "add", "source_pin": "result", "target_node": "multiply", "target_pin": "a"},
    {"id": "data4", "source_node": "add", "source_pin": "result", "target_node": "subtract", "target_pin": "a"},
    {"id": "exec3_true", "source_node": "branch", "source_pin": "true_exec", "target_node": "multiply", "target_pin": "exec_in"},
    {"id": "exec3_false", "source_node": "branch", "source_pin": "false_exec", "target_node": "subtract", "target_pin": "exec_in"},
    {"id": "exec4_true", "source_node": "multiply", "source_pin": "exec_out", "target_node": "end", "target_pin": "exec_in"},
    {"id": "data5_true", "source_node": "multiply", "source_pin": "result", "target_node": "end", "target_pin": "final_result"},
    {"id": "exec4_false", "source_node": "subtract", "source_pin": "exec_out", "target_node": "end", "target_pin": "exec_in"},
    {"id": "data5_false", "source_node": "subtract", "source_pin": "result", "target_node": "end", "target_pin": "final_result"}
  ],
  "variables": {},
  "metadata": {
    "description": "演示执行引脚：Start输出10和5，相加得15，然后根据分支条件，True走乘2路径得30，False走减5路径得10"
  }
}
