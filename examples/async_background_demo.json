{
  "name": "Async Background Demo",
  "version": "1.0.0",
  "description": "演示后台异步执行：主流程立即结束，异步任务在后台继续运行",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "label": "开始",
      "input_pins": [],
      "output_pins": [
        {
          "name": "message",
          "type": "string",
          "value": "主流程开始"
        },
        {
          "name": "bg_value",
          "type": "float",
          "value": 42
        }
      ],
      "position": {"x": 100, "y": 300}
    },
    {
      "id": "async_start",
      "type": "function",
      "operation": "async_start",
      "label": "启动后台任务",
      "input_pins": [],
      "output_pins": [
        {"name": "task_id", "type": "string"},
        {"name": "started", "type": "bool"}
      ],
      "position": {"x": 300, "y": 200}
    },
    {
      "id": "sleep_bg",
      "type": "function",
      "operation": "sleep",
      "label": "后台休眠5秒",
      "input_pins": [
        {"name": "duration", "type": "float", "value": 5000}
      ],
      "output_pins": [
        {"name": "done", "type": "bool"}
      ],
      "position": {"x": 500, "y": 200}
    },
    {
      "id": "calc_bg",
      "type": "arithmetic",
      "operation": "multiply",
      "label": "后台计算",
      "input_pins": [
        {"name": "a", "type": "float"},
        {"name": "b", "type": "float", "value": 10}
      ],
      "output_pins": [
        {"name": "result", "type": "float"}
      ],
      "position": {"x": 700, "y": 200}
    },
    {
      "id": "async_end",
      "type": "function",
      "operation": "async_end",
      "label": "后台任务结束",
      "input_pins": [
        {"name": "task_id", "type": "string"},
        {"name": "result", "type": "any"}
      ],
      "output_pins": [
        {"name": "completed", "type": "bool"}
      ],
      "position": {"x": 900, "y": 200}
    },
    {
      "id": "main_process",
      "type": "function",
      "operation": "constant",
      "label": "主流程继续",
      "input_pins": [
        {"name": "value", "type": "string", "value": "主流程不等待，立即完成"}
      ],
      "output_pins": [
        {"name": "output", "type": "any"}
      ],
      "position": {"x": 500, "y": 400}
    },
    {
      "id": "end",
      "type": "end",
      "label": "主流程结束",
      "input_pins": [
        {"name": "status", "type": "string"}
      ],
      "output_pins": [],
      "position": {"x": 700, "y": 400}
    }
  ],
  "connections": [
    {"id": "c1", "source_node": "start", "source_pin": "bg_value", "target_node": "calc_bg", "target_pin": "a"},
    {"id": "c2", "source_node": "async_start", "source_pin": "task_id", "target_node": "async_end", "target_pin": "task_id"},
    {"id": "c3", "source_node": "calc_bg", "source_pin": "result", "target_node": "async_end", "target_pin": "result"},
    {"id": "c4", "source_node": "start", "source_pin": "message", "target_node": "main_process", "target_pin": "value"},
    {"id": "c5", "source_node": "main_process", "source_pin": "output", "target_node": "end", "target_pin": "status"}
  ],
  "variables": {},
  "metadata": {
    "description": "演示后台异步：后台任务休眠5秒后计算42*10=420，但主流程不等待直接结束。注意：await节点未连接到主流程"
  }
}
