{
  "name": "Control Flow Demo",
  "version": "1.0.0",
  "description": "演示 if/else 条件判断和 for 循环",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "label": "开始",
      "input_pins": [],
      "output_pins": [
        {
          "name": "input_a",
          "type": "float",
          "value": 15
        },
        {
          "name": "input_b",
          "type": "float",
          "value": 10
        }
      ],
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "compare",
      "type": "arithmetic",
      "operation": "greater",
      "label": "比较 A > B",
      "input_pins": [
        {
          "name": "a",
          "type": "float"
        },
        {
          "name": "b",
          "type": "float"
        }
      ],
      "output_pins": [
        {
          "name": "result",
          "type": "bool"
        }
      ],
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "if_else",
      "type": "condition",
      "operation": "if_else",
      "label": "If/Else 分支",
      "input_pins": [
        {
          "name": "condition",
          "type": "bool"
        },
        {
          "name": "then_value",
          "type": "any"
        },
        {
          "name": "else_value",
          "type": "any"
        }
      ],
      "output_pins": [
        {
          "name": "result",
          "type": "any"
        },
        {
          "name": "then_exec",
          "type": "bool"
        },
        {
          "name": "else_exec",
          "type": "bool"
        }
      ],
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "const_then",
      "type": "function",
      "operation": "constant",
      "label": "Then 值",
      "input_pins": [
        {
          "name": "value",
          "type": "float",
          "value": 100
        }
      ],
      "output_pins": [
        {
          "name": "output",
          "type": "float"
        }
      ],
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "const_else",
      "type": "function",
      "operation": "constant",
      "label": "Else 值",
      "input_pins": [
        {
          "name": "value",
          "type": "float",
          "value": 50
        }
      ],
      "output_pins": [
        {
          "name": "output",
          "type": "float"
        }
      ],
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "for_loop",
      "type": "condition",
      "operation": "for_loop",
      "label": "For 循环 (0-10)",
      "input_pins": [
        {
          "name": "start",
          "type": "float",
          "value": 0
        },
        {
          "name": "end",
          "type": "float",
          "value": 10
        },
        {
          "name": "step",
          "type": "float",
          "value": 1
        }
      ],
      "output_pins": [
        {
          "name": "index",
          "type": "float"
        },
        {
          "name": "count",
          "type": "float"
        },
        {
          "name": "completed",
          "type": "bool"
        }
      ],
      "position": {
        "x": 850,
        "y": 200
      }
    },
    {
      "id": "end",
      "type": "end",
      "label": "结束",
      "input_pins": [
        {
          "name": "if_result",
          "type": "any"
        },
        {
          "name": "loop_count",
          "type": "float"
        }
      ],
      "output_pins": [],
      "position": {
        "x": 1100,
        "y": 200
      }
    }
  ],
  "connections": [
    {
      "id": "conn1",
      "source_node": "start",
      "source_pin": "input_a",
      "target_node": "compare",
      "target_pin": "a"
    },
    {
      "id": "conn2",
      "source_node": "start",
      "source_pin": "input_b",
      "target_node": "compare",
      "target_pin": "b"
    },
    {
      "id": "conn3",
      "source_node": "compare",
      "source_pin": "result",
      "target_node": "if_else",
      "target_pin": "condition"
    },
    {
      "id": "conn4",
      "source_node": "const_then",
      "source_pin": "output",
      "target_node": "if_else",
      "target_pin": "then_value"
    },
    {
      "id": "conn5",
      "source_node": "const_else",
      "source_pin": "output",
      "target_node": "if_else",
      "target_pin": "else_value"
    },
    {
      "id": "conn6",
      "source_node": "if_else",
      "source_pin": "result",
      "target_node": "end",
      "target_pin": "if_result"
    },
    {
      "id": "conn7",
      "source_node": "for_loop",
      "source_pin": "count",
      "target_node": "end",
      "target_pin": "loop_count"
    }
  ],
  "variables": {},
  "metadata": {
    "author": "Blueprint Engine",
    "created": "2025-11-20",
    "description": "演示 if/else 条件判断（15 > 10 返回 100，否则返回 50）和 for 循环（0-10，共10次）"
  }
}
