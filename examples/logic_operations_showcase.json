    {"id": "e7_true", "source_node": "branch_access", "source_pin": "true_exec", "target_node": "check_member_xor_paid", "target_pin": "exec_in"},
    {"id": "d11", "source_node": "start", "source_pin": "is_member", "target_node": "check_member_xor_paid", "target_pin": "a"},
    {"id": "d12", "source_node": "start", "source_pin": "has_paid", "target_node": "check_member_xor_paid", "target_pin": "b"},

    {"id": "e8", "source_node": "check_member_xor_paid", "source_pin": "exec_out", "target_node": "check_partial_rights", "target_pin": "exec_in"},
    {"id": "d13", "source_node": "start", "source_pin": "is_member", "target_node": "check_partial_rights", "target_pin": "a"},
    {"id": "d14", "source_node": "start", "source_pin": "has_paid", "target_node": "check_partial_rights", "target_pin": "b"},

    {"id": "e9", "source_node": "check_partial_rights", "source_pin": "exec_out", "target_node": "calc_access_level_full", "target_pin": "exec_in"},

    {"id": "e10", "source_node": "calc_access_level_full", "source_pin": "exec_out", "target_node": "branch_partial", "target_pin": "exec_in"},
