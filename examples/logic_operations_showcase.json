    {"id": "e7_false", "source_node": "branch_access", "source_pin": "false_exec", "target_node": "calc_access_level_denied", "target_pin": "exec_in"},
    {"id": "e14", "source_node": "calc_access_level_denied", "source_pin": "exec_out", "target_node": "end_denied", "target_pin": "exec_in"},
    {"id": "d22", "source_node": "calc_access_level_denied", "source_pin": "result", "target_node": "end_denied", "target_pin": "access_level"}
  ],
  "variables": {},
  "metadata": {
    "description": "逻辑运算展示：模拟权限验证系统，展示AND、OR、NOT、XOR的复杂组合",
    "logic_flow": {
      "basic_access": "is_member AND is_verified",
      "premium_access": "basic_access AND has_paid",
      "admin_override": "is_admin OR premium_access",
      "not_banned": "NOT is_banned",
      "final_access": "admin_override AND not_banned",
      "xor_check": "is_member XOR has_paid (只有一个为真)",
      "partial_rights": "is_member OR has_paid (至少一个为真)",
      "special_case": "xor_check AND not_banned"
    },
    "expected_result": "会员+已验证+已付费+未封禁 -> 完全访问权限100, XOR=false(两者都true), 特殊情况=false"
  }
}
