    {"id": "e4", "source_node": "check_admin_override", "source_pin": "exec_out", "target_node": "check_not_banned", "target_pin": "exec_in"},
    {"id": "d7", "source_node": "start", "source_pin": "is_banned", "target_node": "check_not_banned", "target_pin": "value"},

    {"id": "e5", "source_node": "check_not_banned", "source_pin": "exec_out", "target_node": "final_access_check", "target_pin": "exec_in"},
    {"id": "d8", "source_node": "check_admin_override", "source_pin": "result", "target_node": "final_access_check", "target_pin": "a"},
