{
  "name": "Logic Operations Showcase",
  "version": "1.0.0",
  "description": "逻辑运算展示：AND、OR、NOT、XOR的复杂组合，模拟权限验证系统",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "label": "开始",
      "input_pins": [],
      "output_pins": [
        {"name": "exec", "kind": "exec", "type": "exec"},
        {"name": "is_admin", "kind": "data", "type": "bool", "value": false},
        {"name": "is_member", "kind": "data", "type": "bool", "value": true},
        {"name": "has_paid", "kind": "data", "type": "bool", "value": true},
        {"name": "is_verified", "kind": "data", "type": "bool", "value": true},
        {"name": "is_banned", "kind": "data", "type": "bool", "value": false}
      ],
      "position": {"x": 50, "y": 400}
    },
    {
      "id": "check_basic_access",
      "type": "logic",
      "operation": "and",
      "label": "基础权限: 会员 AND 已验证",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "bool"},
        {"name": "b", "kind": "data", "type": "bool"}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "bool"}
      ],
      "position": {"x": 300, "y": 300}
    },
    {
      "id": "check_premium_access",
      "type": "logic",
      "operation": "and",
      "label": "高级权限: 基础 AND 已付费",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "bool"},
        {"name": "b", "kind": "data", "type": "bool"}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "bool"}
      ],
      "position": {"x": 550, "y": 300}
    },
    {
      "id": "check_admin_override",
      "type": "logic",
      "operation": "or",
      "label": "管理员绕过: 管理员 OR 高级",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "bool"},
        {"name": "b", "kind": "data", "type": "bool"}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "bool"}
      ],
      "position": {"x": 800, "y": 300}
    },
    {
      "id": "check_not_banned",
      "type": "logic",
      "operation": "not",
      "label": "NOT 被封禁",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "value", "kind": "data", "type": "bool"}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "bool"}
      ],
      "position": {"x": 800, "y": 500}
    },
    {
      "id": "final_access_check",
      "type": "logic",
      "operation": "and",
      "label": "最终权限: 有权 AND NOT封禁",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "bool"},
        {"name": "b", "kind": "data", "type": "bool"}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "bool"}
      ],
      "position": {"x": 1050, "y": 400}
    },
    {
      "id": "branch_access",
      "type": "function",
      "operation": "branch",
      "label": "权限分支",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "condition", "kind": "data", "type": "bool"}
      ],
      "output_pins": [
        {"name": "true_exec", "kind": "exec", "type": "exec"},
        {"name": "false_exec", "kind": "exec", "type": "exec"}
      ],
      "position": {"x": 1300, "y": 400}
    },
    {
      "id": "check_member_xor_paid",
      "type": "logic",
      "operation": "xor",
      "label": "特殊情况: 会员 XOR 付费",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "bool"},
        {"name": "b", "kind": "data", "type": "bool"}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "bool"}
      ],
      "position": {"x": 1500, "y": 300}
    },
    {
      "id": "check_partial_rights",
      "type": "logic",
      "operation": "or",
      "label": "部分权限: 会员 OR 付费",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "bool"},
        {"name": "b", "kind": "data", "type": "bool"}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "bool"}
      ],
      "position": {"x": 1750, "y": 300}
    },
    {
      "id": "calc_access_level_full",
      "type": "arithmetic",
      "operation": "multiply",
      "label": "完全访问级别 100",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "float", "value": 100},
        {"name": "b", "kind": "data", "type": "float", "value": 1}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "float"}
      ],
      "position": {"x": 2000, "y": 250}
    },
    {
      "id": "branch_partial",
      "type": "function",
      "operation": "branch",
      "label": "部分权限分支",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "condition", "kind": "data", "type": "bool"}
      ],
      "output_pins": [
        {"name": "true_exec", "kind": "exec", "type": "exec"},
        {"name": "false_exec", "kind": "exec", "type": "exec"}
      ],
      "position": {"x": 2000, "y": 350}
    },
    {
      "id": "calc_access_level_partial",
      "type": "arithmetic",
      "operation": "multiply",
      "label": "部分访问级别 50",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "float", "value": 50},
        {"name": "b", "kind": "data", "type": "float", "value": 1}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "float"}
      ],
      "position": {"x": 2200, "y": 350}
    },
    {
      "id": "calc_access_level_denied",
      "type": "arithmetic",
      "operation": "multiply",
      "label": "拒绝访问 0",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "float", "value": 0},
        {"name": "b", "kind": "data", "type": "float", "value": 1}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "float"}
      ],
      "position": {"x": 2200, "y": 450}
    },
    {
      "id": "check_special_case",
      "type": "logic",
      "operation": "and",
      "label": "特殊组合检查",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "bool"},
        {"name": "b", "kind": "data", "type": "bool"}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "result", "kind": "data", "type": "bool"}
      ],
      "position": {"x": 1500, "y": 500}
    },
    {
      "id": "end_granted",
      "type": "end",
      "label": "授予访问",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "access_level", "kind": "data", "type": "float"},
        {"name": "has_full_access", "kind": "data", "type": "bool"},
        {"name": "xor_result", "kind": "data", "type": "bool"},
        {"name": "special_case", "kind": "data", "type": "bool"}
      ],
      "output_pins": [],
      "position": {"x": 2400, "y": 300}
    },
    {
      "id": "end_denied",
      "type": "end",
      "label": "拒绝访问",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "access_level", "kind": "data", "type": "float"}
      ],
      "output_pins": [],
      "position": {"x": 1500, "y": 600}
    }
  ],
  "connections": [
    {"id": "e1", "source_node": "start", "source_pin": "exec", "target_node": "check_basic_access", "target_pin": "exec_in"},
    {"id": "d1", "source_node": "start", "source_pin": "is_member", "target_node": "check_basic_access", "target_pin": "a"},
    {"id": "d2", "source_node": "start", "source_pin": "is_verified", "target_node": "check_basic_access", "target_pin": "b"},

    {"id": "e2", "source_node": "check_basic_access", "source_pin": "exec_out", "target_node": "check_premium_access", "target_pin": "exec_in"},
    {"id": "d3", "source_node": "check_basic_access", "source_pin": "result", "target_node": "check_premium_access", "target_pin": "a"},
    {"id": "d4", "source_node": "start", "source_pin": "has_paid", "target_node": "check_premium_access", "target_pin": "b"},

    {"id": "e3", "source_node": "check_premium_access", "source_pin": "exec_out", "target_node": "check_admin_override", "target_pin": "exec_in"},
    {"id": "d5", "source_node": "start", "source_pin": "is_admin", "target_node": "check_admin_override", "target_pin": "a"},
