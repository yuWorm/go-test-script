    {"id": "d18_full", "source_node": "calc_access_level_full", "source_pin": "result", "target_node": "end_granted", "target_pin": "access_level"},

    {"id": "e13_partial", "source_node": "calc_access_level_partial", "source_pin": "exec_out", "target_node": "end_granted", "target_pin": "exec_in"},
    {"id": "d18_partial", "source_node": "calc_access_level_partial", "source_pin": "result", "target_node": "end_granted", "target_pin": "access_level"},

    {"id": "d19", "source_node": "final_access_check", "source_pin": "result", "target_node": "end_granted", "target_pin": "has_full_access"},
