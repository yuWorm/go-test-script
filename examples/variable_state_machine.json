      "type": "arithmetic",
      "operation": "multiply",
      "label": "连击奖励 = 连击*10",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "a", "kind": "data", "type": "float"},
        {"name": "b", "kind": "data", "type": "float", "value": 10}
