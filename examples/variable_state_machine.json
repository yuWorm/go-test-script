        {"name": "name", "kind": "data", "type": "string", "value": "multiplier"},
        {"name": "value", "kind": "data", "type": "float", "value": 1}
      ],
      "output_pins": [
        {"name": "exec_out", "kind": "exec", "type": "exec"},
        {"name": "value", "kind": "data", "type": "float"}
      ],
      "position": {"x": 250, "y": 400}
    },
    {
      "id": "init_bonus",
      "type": "function",
      "operation": "set_variable",
      "label": "初始化奖励",
      "input_pins": [
        {"name": "exec_in", "kind": "exec", "type": "exec"},
        {"name": "name", "kind": "data", "type": "string", "value": "bonus"},
        {"name": "value", "kind": "data", "type": "float", "value": 0}
